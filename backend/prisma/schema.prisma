generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ShortLink {
  id          Int      @id @default(autoincrement())
  shortCode   String   @unique          
  originalUrl String                    
  clicks      Int      @default(0)       
  createdAt   DateTime @default(now())   

  @@map("short_links")                   
}